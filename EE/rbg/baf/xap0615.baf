IF
	Clicked([ANYONE])
	Range(LastTrigger,10)
	GlobalLT("XA_LC_StoleLedger", "GLOBAL", 1)
THEN
	RESPONSE #100
		SetGlobal("XA_LC_StoleLedger", "GLOBAL", 1)
		Continue()
END

IF
	Clicked([ANYONE])
	!Range(LastTrigger,10)
THEN
	RESPONSE #100
		DisplayString(Myself,@0)  /* ~You are too far away to use that.~ */
END
IF
	!See([ENEMY])
	See([PC])
	GlobalLT("XA_LC_2802_EnemiesDead", "MYAREA", 1)
THEN
	RESPONSE #100
		SetGlobal("XA_LC_2802_EnemiesDead", "MYAREA", 1)
		Continue()
END

IF
	Global("XA_LC_2802_EnemiesDead", "MYAREA", 1)
THEN 
	RESPONSE #100
		StartDialogueNoSet([PC])
END

IF 
	ActionListEmpty()
	Global("XA_LC_2802_EnemiesDead", "MYAREA", 2)
THEN
	RESPONSE #100
		EscapeArea()
END